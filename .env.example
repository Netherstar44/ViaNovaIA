# ViaNova IA — variables de entorno (ejemplo, sin secretos reales).
# Copia este archivo a .env y rellena valores. Nunca lo subas al repositorio.

# Entorno: development | production | test
NODE_ENV=development

# PostgreSQL/Neon. En producción usa sslmode=require.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Catálogo restringido del chatbot (opcional pero recomendado). Usa un rol de
# solo lectura que únicamente pueda consultar catalog.catalog_items.
# scripts/seed-neiva.mjs crea el rol y escribe esta variable automáticamente.
CATALOG_DATABASE_URL=postgresql://vianova_catalog_reader:password@host/database?sslmode=require

# Contraseña del usuario demo de scripts/seed-neiva.mjs (mínimo 12 caracteres).
# No se versiona; el seed falla si falta.
SEED_DEMO_PASSWORD=

# Secretos de autenticación y sesión. Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Deben tener al menos 32 caracteres y ser distintos entre sí.
JWT_SECRET=replace-with-random-secret-at-least-32-chars
SESSION_SECRET=replace-with-another-random-secret-at-least-32-chars
JWT_EXPIRES_IN=2h
SESSION_IDLE_MINUTES=120

# Clave dedicada para AES-256-GCM de datos de pago. Si falta, se deriva de
# JWT_SECRET por compatibilidad; en producción define una propia.
PAYMENT_ENCRYPTION_KEY=replace-with-a-dedicated-random-secret

# Orígenes exactos permitidos para CORS/CSRF, separados por coma.
# No uses "*". Incluye solo el dominio web real.
CORS_ALLOWED_ORIGINS=https://via-nova-ia.vercel.app
CLIENT_URL=https://via-nova-ia.vercel.app
PUBLIC_URL=https://via-nova-ia.vercel.app
# APP_URL=https://via-nova-ia.vercel.app

# Google Sign-In. GOOGLE_ALLOWED_CLIENT_IDS admite IDs web/Android separados por coma.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MOBILE_CLIENT_ID=
GOOGLE_ALLOWED_CLIENT_IDS=
# Debe coincidir exactamente con una URI autorizada en Google Cloud Console.
# Desarrollo local con `npm run dev`: http://localhost:5000/api/auth/google
GOOGLE_REDIRECT_URI=

# Cloudinary (subidas de imágenes/video/modelos).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (chatbot). Sin clave el chat usa respuesta de respaldo.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# SMTP para verificación y recuperación de contraseña.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ViaNova <no-reply@vianova.example>

# Stripe (opcional; sin claves el checkout responde 503 y el webhook no procesa).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Wompi (pagos de rutas). En sandbox usa el enlace de prueba sin llaves; para
# firmar monto/referencia configura las llaves de integración.
PAYMENT_SANDBOX_MODE=true
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/l/test_VPOS_tGKfH8
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Solo se usa si WOMPI_PUBLIC_KEY y WOMPI_INTEGRITY_SECRET están configuradas.
# WOMPI_PRIVATE_KEY=

# Rate limiting distribuido opcional (Vercel/Workers). Si no se define, se usa
# el almacén en memoria de cada instancia.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Cliente (Vite). Solo valores públicos; nunca pongas secretos aquí.
VITE_NATIVE_API_BASE=
VITE_MAPBOX_TOKEN=
