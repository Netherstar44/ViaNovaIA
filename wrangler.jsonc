{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vianova",
  "pages_build_output_dir": "dist/public",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "BACKEND_URL": "https://via-nova-ia.vercel.app"
  }
}
